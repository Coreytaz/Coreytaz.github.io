{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "nextjs"],
  "categories": { "correctness": "error" },
  "rules": { "react/hooks": "error", "react/exhaustive-deps": "error" },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "out",
    "reports",
    "test-results",
    "playwright-report",
    "next-env.d.ts"
  ]
}
