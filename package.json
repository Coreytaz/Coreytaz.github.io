{
  "name": "stepan-bykov-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "26.x",
    "npm": ">=12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "next dev",
    "content:check": "tsx scripts/check-content.ts",
    "content:schema": "tsx scripts/generate-schema.ts",
    "assets:build": "tsx scripts/prepare-assets.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && oxlint src scripts tests next.config.ts playwright.config.ts",
    "test:unit": "tsx --test tests/content.test.ts",
    "build": "npm run content:check && npm run assets:build && next build && tsx scripts/finalize-export.ts",
    "preview": "node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run content:check && npm run lint && npm run typecheck && npm run test:unit",
    "audit": "npm audit --omit=dev",
    "lighthouse": "node scripts/lighthouse.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "lighthouse": "13.5.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "type": "module"
}
